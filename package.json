{
  "name": "codesamplez-tools",
  "version": "1.0.0",
  "description": "Browser-based developer utilities that run client-side and build into standalone static artifacts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranacseruet/codesamplez-tools.git"
  },
  "homepage": "https://github.com/ranacseruet/codesamplez-tools#readme",
  "bugs": {
    "url": "https://github.com/ranacseruet/codesamplez-tools/issues"
  },
  "keywords": [
    "developer-tools",
    "browser-tools",
    "client-side",
    "formatters",
    "converters",
    "preact"
  ],
  "engines": {
    "node": "24.x"
  },
  "browserslist": [
    "last 2 Chrome major versions",
    "last 2 Edge major versions",
    "last 2 Firefox major versions",
    "last 2 Safari major versions",
    "last 2 iOS major versions",
    "last 2 ChromeAndroid major versions",
    "not dead",
    "not ie <= 11"
  ],
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "start": "http-server build -c-1 -p 8080",
    "dev": "NODE_ENV=development webpack serve --mode development",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "verify-build": "node scripts/build-verification.js",
    "typecheck": "tsc --project tsconfig.json",
    "audit:deps": "npm audit --audit-level=high",
    "bundle-metrics": "node scripts/measure-bundles.js --format markdown --write-default-json",
    "bundle-budget-check": "node scripts/check-bundle-budgets.js",
    "qa:a11y:foundation": "node scripts/a11y-baseline-ui-foundation.mjs",
    "qa:cross-browser": "node scripts/cross-browser-signoff.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@babel/core": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/register": "^7.28.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.5",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "cssnano": "^7.0.6",
    "file-loader": "^6.2.0",
    "http-server": "^14.1.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^26.1.0",
    "mini-css-extract-plugin": "^2.10.1",
    "playwright": "^1.58.2",
    "postcss-cli": "^11.0.0",
    "style-loader": "^4.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "**/*.test.[jt]s?(x)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transform": {
      "^.+\\.(ts|tsx|js|jsx)$": [
        "babel-jest",
        {
          "rootMode": "upward"
        }
      ]
    },
    "moduleNameMapper": {
      "^preact$": "<rootDir>/node_modules/preact/dist/preact.js",
      "^preact/hooks$": "<rootDir>/node_modules/preact/hooks/dist/hooks.js",
      "^preact/jsx-runtime$": "<rootDir>/node_modules/preact/jsx-runtime/dist/jsxRuntime.js"
    },
    "testEnvironmentOptions": {
      "url": "http://localhost"
    }
  },
  "dependencies": {
    "@babel/generator": "^7.28.6",
    "@babel/parser": "^7.28.6",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.28.6",
    "@material/web": "^2.4.1",
    "core-js": "^3.48.0",
    "diff": "^8.0.3",
    "fast-xml-parser": "^5.5.3",
    "js-yaml": "^4.1.1",
    "preact": "^10.28.4",
    "preact-render-to-string": "^6.6.6",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4"
  }
}

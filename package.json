{
  "name": "codesamplez-tools",
  "version": "1.0.0",
  "description": "A collection of utility tools",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "start": "http-server build -c-1 -p 8080",
    "dev": "NODE_ENV=development webpack serve --mode development",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "verify-build": "node scripts/build-verification.js"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "cssnano": "^7.0.6",
    "file-loader": "^6.2.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss-cli": "^11.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "transform": {
      "^.+\\.js$": [
        "babel-jest",
        {
          "rootMode": "upward"
        }
      ]
    },
    "testEnvironmentOptions": {
      "url": "http://localhost"
    }
  },
  "dependencies": {
    "@babel/generator": "^7.28.6",
    "@babel/parser": "^7.28.6",
    "@babel/traverse": "^7.28.6",
    "@babel/types": "^7.28.6",
    "core-js": "^3.48.0",
    "diff": "^7.0.0",
    "fast-xml-parser": "^5.2.5",
    "js-yaml": "^4.1.0",
    "qrcode": "^1.5.4"
  }
}
